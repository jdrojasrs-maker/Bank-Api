<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Versiones: xunit, Microsoft.NET.Test.Sdk, xunit.runner.visualstudio y coverlet vienen de la plantilla "dotnet new xunit" del SDK 10.0.401;
       Testcontainers.MsSql 4.16.0 es la última estable resuelta por "dotnet add package" el 2026-11-03. Requiere Docker en marcha. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bank.Transfer\Bank.Transfer.Api\Bank.Transfer.Api.csproj" />
  </ItemGroup>

</Project>