# Copiar a .env (no se versiona) y completar SQL_PASSWORD.
# Contraseña de SQL Server: min. 8 caracteres y 3 de 4 clases (mayúsculas, minúsculas, números, símbolos).
ACCEPT_EULA=Y
SQL_PASSWORD=
SQL_WAIT_INTERVAL=15
EMULATOR_HTTP_PORT=5300

# Opcional: ruta absoluta al Config.json. En Windows, doble barra invertida.
# Por defecto usa ./Config.json (junto a este archivo).
# CONFIG_PATH=C:\\Users\\<usuario>\\source\\repos\\Bank\\infra\\local\\Config.json
