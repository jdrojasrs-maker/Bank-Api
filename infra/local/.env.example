# Copy to .env (not versioned) and fill in SQL_PASSWORD.
# SQL Server password: min. 8 characters and 3 of 4 classes (uppercase, lowercase, digits, symbols).
ACCEPT_EULA=Y
SQL_PASSWORD=
SQL_WAIT_INTERVAL=15
EMULATOR_HTTP_PORT=5300

# Optional: absolute path to Config.json. On Windows, double backslash.
# By default it uses ./Config.json (next to this file).
# CONFIG_PATH=C:\\Users\\<usuario>\\source\\repos\\Bank\\infra\\local\\Config.json
